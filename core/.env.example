# Alpaca account mode. The Alpaca Key ID/Secret themselves are NOT configured here -
# they're never persisted to disk. Connect your account after starting the backend via
# POST /api/v1/alpaca/connect (held in-memory only; the desktop app's onboarding form
# does this for you). See docs/ARCHITECTURE.md for why.
ALPACA_PAPER=true

# Risk limits
MAX_POSITION_DOLLARS=5000.0
DAILY_LOSS_LIMIT_PCT=0.03

# Network binding - keep this on localhost; this API can place real (paper) trades
# and is not designed to be exposed beyond the machine it runs on.
HOST=127.0.0.1
PORT=8000

# Comma-separated list of allowed CORS origins, e.g. http://localhost:5173
# Leave blank if only the Electron main process calls this API (no Origin header sent).
ALLOWED_ORIGINS=

# SQLite file backing the risk manager's kill-switch / daily-drawdown state,
# so it survives process restarts.
DB_PATH=./tide_trader_state.db

# --- Trade-suggestion agent (notify-only: it can never place an order) ---
# Once an Alpaca account is connected, a background loop scans your watchlist plus
# Alpaca's most-active/movers every SCAN_INTERVAL_SECONDS (Alpaca market-data calls only).
# Set ENABLE_SUGGESTION_SCANNER=false to turn it off entirely.
ENABLE_SUGGESTION_SCANNER=true
SCAN_INTERVAL_SECONDS=300
SCAN_MIN_SCORE=60.0
SCAN_MOST_ACTIVE_TOP=10
SCAN_MOVERS_TOP=10

# Optional: Claude writes a short plain-English rationale for each suggestion.
# Leave ANTHROPIC_API_KEY blank to skip rationales (suggestions still work).
# NOTE: unlike the Alpaca keys, this key lives in plaintext in .env - see
# docs/ARCHITECTURE.md ("Trade-suggestion agent"). Use a key with a low spend limit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
